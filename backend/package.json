{
  "name": "epicerie-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Épicerie Decoupled Express.js Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
